# a drifted database, with pending files
render-migrate-drift migrate-drift.tmpl data-0.json
cmp stdout golden-0.html

# the targets of an environment: a database that matches its expected state, and one that could not be checked
render-migrate-drift migrate-drift.tmpl data-1.json
cmp stdout golden-1.html

# registry mode, a URL to escape, a change without statements, and a statement over multiple lines
render-migrate-drift migrate-drift.tmpl data-2.json
cmp stdout golden-2.html

