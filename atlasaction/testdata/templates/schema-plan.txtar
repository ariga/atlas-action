```sql
-- Drop index "orders_total" from table: "orders"
DROP INDEX "orders_total";
-- Modify "orders" table
ALTER TABLE "orders" DROP COLUMN "total", ADD COLUMN "total" integer NULL GENERATED ALWAYS AS (amount * 2) STORED;
-- Create index "orders_total" to table: "orders"
CREATE INDEX "orders_total" ON "orders" ("total");
-- Drop "open_order_customers" view
DROP VIEW "open_order_customers";
-- Drop "open_orders" view
DROP VIEW "open_orders";
-- Create "open_orders" table
CREATE TABLE "open_orders" (
  "id" integer NOT NULL,
  "customer_id" integer NOT NULL,
  PRIMARY KEY ("id")
);
-- Create "open_order_customers" view
CREATE VIEW "open_order_customers" (
  "customer_id"
) AS SELECT customer_id
   FROM open_orders;
```

