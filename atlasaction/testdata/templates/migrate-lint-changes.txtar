# The change summary that GitHub adds to the migrate lint comment, for each file that
# changes schema objects, in lint order. Files without schema changes, such as the seed
# file, and statements that change no object are left out.
render-lint-comment lint-changes.tmpl data-1.json
cmp stdout golden-1.html

# Statement counts only, as in a job summary over the size limit.
render-lint-comment lint-changes.tmpl data-2.json
cmp stdout golden-2.html

# The objects of a file that runs as one batch have no statements, and no statements column.
render-lint-comment lint-changes.tmpl data-3.json
cmp stdout golden-3.html

