# Mock atlas command outputs
env ATLAS_PATH=$MOCK_ATLAS TEST_BATCH=./schema-plan
env GITHUB_RUN_ID=123

# Outside a pull request, the plan is reported in the step summary.
atlas-action --action=schema/plan
summary summary-expected.txt

-- schema-plan/1/args --
schema plan list --format {{ json . }} --context {"scmType":"GITHUB"} --pending --auto-approve

-- schema-plan/1/stdout --
[]

-- schema-plan/2/args --
schema plan --format {{ json . }} --context {"scmType":"GITHUB"} --name-format ref--{{ printf "%.8s" (base64url .FromHash) }} --pending --auto-approve

