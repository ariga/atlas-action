# Mock the atlas command outputs
env ATLAS_PATH=$MOCK_ATLAS TEST_BATCH=./security-scan
# Setup the action input variables
env INPUT_URLS=postgres://localhost:5432/app
env INPUT_MIN-SEVERITY=ELEVATED
env INPUT_IGNORE=CVE-2017-18359

atlas-action --action=security/scan
stdout 'completed successfully, no issues found'

# Issues that reached the failing severity fail the action, and are still reported.
env INPUT_FAIL-ON=HIGH
env TEST_EXIT_CODE=1
! atlas-action --action=security/scan
stdout '::error::.*completed with 2 issue.s.: 1 high, 1 elevated'

# A database that could not be scanned leaves its state unknown.
! atlas-action --action=security/scan
stdout '::error::.*could not scan 1 database'

output output.txt
summary summary.html

-- security-scan/1/args --
security scan --url postgres://localhost:5432/app --min-severity ELEVATED --ignore CVE-2017-18359 --format {{ json . }}
-- security-scan/1/stdout --
{"Targets":[{"URL":"postgres://localhost:5432/app","Driver":"postgres","Version":"9.3.0","Extensions":["pgcrypto"]}]}
-- security-scan/2/args --
security scan --url postgres://localhost:5432/app --min-severity ELEVATED --fail-on HIGH --ignore CVE-2017-18359 --format {{ json . }}
-- security-scan/2/stdout --
{"Targets":[{"URL":"postgres://localhost:5432/app","Driver":"postgres","Version":"9.3.0","Extensions":["hstore","postgis"],"Vulnerabilities":[{"Name":"postgis","Version":"2.3.1","ID":"CVE-2017-18359","Level":"HIGH","Severity":"HIGH","Suggestion":"Upgrade extension \"postgis\" to version 2.3.3 or later to resolve CVE-2017-18359"},{"Name":"hstore","Version":"1.3","ID":"CVE-2014-2669","Level":"ELEVATED","Severity":"MEDIUM","Suggestion":"Upgrade the database engine to version 9.3.3 or later to resolve CVE-2014-2669: the fix for extension \"hstore\" ships in engine releases"}]}]}
-- security-scan/3/args --
security scan --url postgres://localhost:5432/app --min-severity ELEVATED --fail-on HIGH --ignore CVE-2017-18359 --format {{ json . }}
-- security-scan/3/stdout --
{"Targets":[{"URL":"postgres://localhost:5432/app","Driver":"postgres","Error":"connection refused"}]}
