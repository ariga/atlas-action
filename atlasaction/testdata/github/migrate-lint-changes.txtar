# Outside a pull request, the change summary of each linted file is in the step summary,
# with plain keycaps, since job summaries may not render math. The file without schema
# changes has no section.
env ATLAS_PATH=$MOCK_ATLAS TEST_BATCH=./migrate-lint
env INPUT_DIR-NAME=app
env INPUT_DIR=file://migrations
env INPUT_DEV-URL=sqlite://dev?mode=memory

atlas-action --action=migrate/lint
summary summary-expected.txt

-- migrate-lint/1/args --
migrate lint -w --context {"path":"file://migrations","scmType":"GITHUB"} --dev-url sqlite://dev?mode=memory --dir file://migrations --base atlas://app --format {{ json . }}
-- migrate-lint/1/stdout --
{"Env":{"Dir":"migrations"},"Files":[{"Name":"2_users.sql","Stmts":[{"Text":"ALTER TABLE `users` ADD COLUMN `email` text NULL;"},{"Text":"CREATE TABLE `orders` (`id` integer NOT NULL, PRIMARY KEY (`id`));"}],"Changes":{"Objects":[{"Op":"modify","Object":"table \"users\"","Diff":" `id` integer NOT NULL,\n+ `email` text NULL,\n PRIMARY KEY (`id`)","Stmts":[0]},{"Op":"add","Object":"table \"orders\"","Diff":"+CREATE TABLE `orders` (\n+ `id` integer NOT NULL,\n+ PRIMARY KEY (`id`)\n+);","Stmts":[1]}],"Stmts":2}},{"Name":"3_seed.sql","Stmts":[{"Text":"INSERT INTO `users` (`id`) VALUES (1);"}],"Changes":{"Other":[0],"Stmts":1}}]}
