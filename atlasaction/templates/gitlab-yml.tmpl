# Generated by go run ./cmd/gen gitlab-template; DO NOT EDIT.
spec:
  inputs:
    job_name:
      description: The name of the job.
      default: {{ .ID | replace "/" "-" | printf "atlas-%s" }}
    stage:
      description: The CI stage to run the job in.
      default: ""
    atlas-version:
      description: Install a specific Atlas version.
      default: latest
    gitlab-token:
      description: A Gitlab access token for posting merge request comments.
      default: ""
{{- if ne .ID "monitor/schema" }}
    atlas-cloud-token:
      description: A token for Atlas Cloud.
      default: ""
{{- end }}
{{- range $name, $input := .SortedInputs }}
    {{ $name }}:
      type: {{ $input.GitLabType }}
      description: {{ $input.Description | yaml 8 | trimnl }}{{ with $input.Default }}
      default: {{ . }}{{ else }}{{ if not .Required }}
      default: {{ if eq $input.Type "number" }}0{{ else }}""{{ end }}
      {{- end }}{{ end }}
    {{- with .Options }}
      options:
        {{- if and (eq $input.Default "") (not $input.Required) }}
        - ""
        {{- end }}
        {{- range $v := . }}
        - {{ $v }}
        {{- end }}
    {{- end }}
{{- end }}

---
$[[ inputs.job_name ]]:
  stage: $[[ inputs.stage ]]
  cache: {{/* cross-pipeline sharing */}}
    - key: atlas-grant-cache
      paths:
        - .atlas/
      policy: pull-push
    - key: atlas-bin
      paths:
        - .atlas-bin/
      policy: pull-push
  artifacts: {{/* cross-job sharing */}}
{{- if .Outputs }}
    reports:
      dotenv: .env
{{- end }}
    paths:
      - .atlas/
    expire_in: 1 day
  before_script:
    - |
      if command -v curl >/dev/null 2>&1; then
        :
      elif command -v apk >/dev/null 2>&1; then
        apk add --no-cache curl
      elif command -v apt >/dev/null 2>&1; then
        apt update -q && apt install -y curl
      else
        echo "Unsupported OS: neither apk nor apt found"
        exit 1
      fi
      {{- /* cannot cache/artifact non project files */}}
      mkdir -p ~/.atlas
      cp -a $CI_PROJECT_DIR/.atlas/. ~/.atlas/ 2>/dev/null || true
      {{- /* keep the cached binaries out of `git add .`; write once so the cache is not re-uploaded */}}
      mkdir -p $CI_PROJECT_DIR/.atlas-bin
      [ -f $CI_PROJECT_DIR/.atlas-bin/.gitignore ] || echo '*' > $CI_PROJECT_DIR/.atlas-bin/.gitignore
      {{- /* e.g. a digest-pinned arigaio/atlas image; only an exact version match skips the install */}}
      if command -v atlas >/dev/null 2>&1 && [ "$(atlas version 2>/dev/null | head -n1)" = "atlas version $[[ inputs.atlas-version ]]" ]; then
        echo "Using pre-installed $(command -v atlas)"
      else
        curl -sSf https://atlasgo.sh | ATLAS_VERSION="$[[ inputs.atlas-version ]]" sh -s -- -o $CI_PROJECT_DIR/.atlas-bin/atlas
        export PATH="$CI_PROJECT_DIR/.atlas-bin:$PATH"
      fi
{{- if ne .ID "monitor/schema" }}
      atlas login --token $[[ inputs.atlas-cloud-token ]] --grant-only
{{- end }}
{{- if eq .ID "migrate/diff" }}
      # Set up git
      git fetch $[[ inputs.remote ]] $CI_COMMIT_REF_NAME
      git config --global user.email "gitlab-ci@users.noreply.gitlab.com"
      git config --global user.name "GitLab CI"
      git remote set-url $[[ inputs.remote ]] "https://oauth2:$[[ inputs.gitlab-token ]]@$CI_SERVER_HOST/$CI_PROJECT_PATH.git"
{{- end }}
  script:
    - |
      case "$(uname -m)" in
        x86_64|amd64)  arch=amd64; sum={{ index .Checksums "linux-amd64" }} ;;
        aarch64|arm64) arch=arm64; sum={{ index .Checksums "linux-arm64" }} ;;
        *) echo "Unsupported architecture: $(uname -m)"; exit 1 ;;
      esac
      sha() { sha256sum "$1" 2>/dev/null | cut -d' ' -f1; }
      {{- /* the arigaio/atlas-action image ships the very same binary */}}
      bin="$(command -v atlas-action || true)"
      if [ -z "$bin" ] || [ "$(sha "$bin")" != "$sum" ]; then
        {{- /* the cache is shared across versions, so verify it on every run */}}
        bin="$CI_PROJECT_DIR/.atlas-bin/atlas-action"
        if [ "$(sha "$bin")" != "$sum" ]; then
          file="atlas-action-linux-$arch-v{{ .Version }}"
          curl -sSfL -o "$bin" "https://atlasbinaries.com/atlas-action/$file" || \
            curl -sSfL -o "$bin" "https://release.ariga.io/atlas-action/$file"
          if [ "$(sha "$bin")" != "$sum" ]; then
            rm -f "$bin"
            echo "Checksum mismatch for $file"
            exit 1
          fi
        fi
        chmod +x "$bin"
      fi
      "$bin" --action {{ .ID }}
  after_script:
    - mkdir -p $CI_PROJECT_DIR/.atlas
    - cp -a ~/.atlas/. $CI_PROJECT_DIR/.atlas/ 2>/dev/null || true
  variables:
    GITLAB_TOKEN: $[[ inputs.gitlab-token ]]
{{- if ne .ID "monitor/schema" }}
    ATLAS_TOKEN: $[[ inputs.atlas-cloud-token ]]
{{- end }}
{{- range $name, $input := .SortedInputs }}
    {{ $name | inputvar }}: $[[ inputs.{{ $name }} ]]
{{- end }}
{{- if or (eq .ID "migrate/diff") (eq .ID "migrate/lint") }}
  rules:
    - if: "$CI_MERGE_REQUEST_IID"
      when: always
{{- else if eq .ID "monitor/schema" }}
  rules:
    - if: $CI_PIPELINE_SOURCE == "schedule"
      when: on_success
    - when: manual
{{- end }}
